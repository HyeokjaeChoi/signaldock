# Copy to .env (gitignored) and change the values. These are example values for
# local evaluation only. The two keys must differ: the server refuses to start
# otherwise (Q131).
SIGNALDOCK_COLLECTION_KEY=example-collection-key-change-me
SIGNALDOCK_QUERY_KEY=example-query-key-change-me

# PostgreSQL. Compose creates the database with these values on first start.
SIGNALDOCK_DB_NAME=signaldock
SIGNALDOCK_DB_USER=signaldock
SIGNALDOCK_DB_PASSWORD=example-db-password-change-me

# Host ports, bound to 127.0.0.1 only.
SIGNALDOCK_DB_PORT=5432
SIGNALDOCK_SERVER_PORT=8080
SIGNALDOCK_DASHBOARD_PORT=5173

# Project time zone (region ID). Default Asia/Seoul.
SIGNALDOCK_TIME_ZONE=Asia/Seoul

# Local development only (Ktor and Vite on the host, DB-only Compose):
# the server reads these directly. In Compose the server container sets its own.
SIGNALDOCK_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/signaldock
PORT=8080
