server {
    listen 8080;
    root /usr/share/nginx/html;

    location / {
        try_files $uri /index.html;
    }

    # Q129: same-origin proxy. The browser sends no key; nginx adds the query key.
    # Only reads go through, so the query key cannot reach ingestion from the browser.
    location /v1/ {
        limit_except GET { deny all; }
        proxy_pass http://server:8080;
        proxy_set_header Authorization "Bearer ${SIGNALDOCK_QUERY_KEY}";
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }
}
