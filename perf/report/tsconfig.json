{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": { "react": ["./node_modules/@types/react"], "axe-core": ["./node_modules/axe-core"] },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*", "vite.config.mts", "../../web-shared/**/*.ts"],
  "exclude": ["../../web-shared/**/*.test.ts"]
}
