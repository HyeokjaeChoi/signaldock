        android:allowBackup="false"
        android:label="SignalDock Measure"
        android:usesCleartextTraffic="true" />
    <instrumentation
        android:name=".MeasureInstrumentation"
        android:targetPackage="local.signaldock.measureapp" />
</manifest>
