#!/bin/bash
# Run the real verification before code reaches review. A fix that was never
# run regressed twice on PR #9 (oasdiff -o, file modes). Docs-only pushes skip
# the slow part.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/scripts/check-repo-rules.sh"

zero=0000000000000000000000000000000000000000
code_changed=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch delete
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    if [ -z "$base" ]; then
      code_changed=1 # no merge base: fail closed
      continue
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  changed="$(git diff --name-only "$range" -- . ':!*.md' ':!docs/' ':!.scratch/')"
  if [ -n "$changed" ]; then
    code_changed=1
  fi
done

if [ "$code_changed" = 1 ]; then
  echo "pre-push: code changed, running scripts/verify-contract.sh" >&2
  echo "pre-push: if a pinned tool is missing, install it (TOOLCHAIN.md)." >&2
  echo "pre-push: --no-verify skips this; then say so in the PR instead of claiming verification." >&2
  "$ROOT/scripts/verify-contract.sh"
fi
