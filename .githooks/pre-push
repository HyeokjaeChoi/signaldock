#!/bin/bash
# Run the real verification before code reaches review. A fix that was never
# run regressed twice on PR #9 (oasdiff -o, file modes). Docs-only pushes skip
# the slow part.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
refs="$(cat)" # stdin is read once

# Verification runs on the working tree, so it must match the pushed commits.
head_sha="$(git rev-parse HEAD)"
dirty=0
git diff --quiet || dirty=1
git diff --cached --quiet || dirty=1
while read -r _ local_sha _ _; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue # branch delete
  if [ "$local_sha" != "$head_sha" ] || [ "$dirty" = 1 ]; then
    echo "pre-push: the pushed commit is not the checked-out HEAD, or tracked files have changes." >&2
    echo "pre-push: push the checked-out branch from a clean tree, or use --no-verify and say so in the PR." >&2
    exit 1
  fi
done <<<"$refs"

"$ROOT/scripts/check-repo-rules.sh"

code_changed=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch delete
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    if [ -z "$base" ]; then
      code_changed=1 # no merge base: fail closed
      continue
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  changed="$(git diff --name-only "$range" -- . ':!*.md' ':!docs/' ':!.scratch/')"
  if [ -n "$changed" ]; then
    code_changed=1
  fi
done <<<"$refs"

if [ "$code_changed" = 1 ]; then
  echo "pre-push: code changed, running scripts/verify-contract.sh" >&2
  echo "pre-push: if a pinned tool is missing, install it (TOOLCHAIN.md)." >&2
  echo "pre-push: --no-verify skips this; then say so in the PR instead of claiming verification." >&2
  "$ROOT/scripts/verify-contract.sh"
fi
